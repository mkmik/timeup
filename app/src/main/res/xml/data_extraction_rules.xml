<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (PRD §10.A): the database goes to the user's Google account,
     end-to-end encrypted with the screen lock; skipped entirely if that is not possible. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="timeup.db" />
        <include domain="database" path="timeup.db-wal" />
        <include domain="database" path="timeup.db-shm" />
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="timeup.db" />
        <include domain="database" path="timeup.db-wal" />
        <include domain="database" path="timeup.db-shm" />
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
